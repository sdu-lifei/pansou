# PanSou 环境变量配置
# 复制此文件为 .env 并填写对应值

# ── Telegram 频道 (必填) ───────────────────────────────────
# 多个频道用逗号分隔
CHANNELS=tgsearchers5,Quark_Movies,Lsp115,Aliyun_4K_Movies

# ── 代理 (可选, 国内服务器必填) ──────────────────────────────
# PROXY=http://127.0.0.1:7890

# ── 服务端口 ──────────────────────────────────────────────
PORT=8888

# ── 微信公众号 (必填，开通公众号搜索功能时配置) ──────────────
# 在微信公众号后台 → 开发 → 基本配置 → 服务器配置 中设置
WECHAT_TOKEN=your_wechat_token_here
# WECHAT_APPID=your_appid_here       # 可选，高级功能用
# WECHAT_APPSECRET=your_secret_here  # 可选，高级功能用

# ── 认证 (可选) ────────────────────────────────────────────
# AUTH_ENABLED=false
# AUTH_USERS=admin:password123
# AUTH_TOKEN_EXPIRY=24
